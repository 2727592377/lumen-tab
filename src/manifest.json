{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDesc__",
  "version": "1.0.2",
  "default_locale": "zh_CN",
  "browser_specific_settings": {
    "gecko": {
      "id": "lumen-tab@local.buying",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "searchTerms"
        ],
        "optional": []
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "bookmarks",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "js/background.js"
    ]
  },
  "sidebar_action": {
    "default_panel": "sidebar.html",
    "default_title": "__MSG_sidebarTitle__",
    "default_icon": "icons/icon.svg"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_icon": "icons/icon.svg"
  },
  "commands": {
    "focus-search": {
      "suggested_key": {
        "default": "Ctrl+K"
      },
      "description": "__MSG_cmdFocusSearch__"
    },
    "open-settings": {
      "suggested_key": {
        "default": "Ctrl+Shift+Comma"
      },
      "description": "__MSG_cmdOpenSettings__"
    }
  }
}
